    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "build:esm-famil": "node scripts/build-esm-famil.mjs"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@prisma/adapter-pg": "^7.10.1",

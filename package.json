    "chess.js": "^1.4.0",
    "jose": "^6.2.14",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.6.3",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
